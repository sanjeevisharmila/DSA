class Solution {
    public int rob(int[] nums) {
        int n=nums.length;
        int first=houserob(nums,0,n-2);
        int second=houserob(nums,1,n-1);
        return Math.max(first,second);
    }
    public int houserob(int[] nums,int i,int n){
        if(i>n){
            return 0;
        }
        int fir=nums[i]+houserob(nums,i+2,n);
        int sec=houserob(nums,i+1,n);
        return Math.max(fir,sec);
    }
}

time=O(2^n)
space=O(n)

class Solution {
    public int rob(int[] nums) {
        int n=nums.length;
         if(n==1){
            return nums[0];
        }
        int[] dp1=new int[n];
        int[] dp2=new int[n];
        Arrays.fill(dp1,-1);
        Arrays.fill(dp2,-1);
        int first=houserob(nums,0,n-2,dp1);
        int second=houserob(nums,1,n-1,dp2);
        return Math.max(first,second);
    }
    public int houserob(int[] nums,int i,int n,int[] dp){
        if(i>n){
            return 0;
        }
        if(dp[i]!=-1)
        return dp[i];
        int fir=nums[i]+houserob(nums,i+2,n,dp);
        int sec=houserob(nums,i+1,n,dp);
        return dp[i]=Math.max(fir,sec);
    }
}

time=O(n)
space=O(n)
