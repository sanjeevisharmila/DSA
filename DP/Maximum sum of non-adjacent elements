public class Main {

    static int maxSum(int[] nums, int index) {

        // Base case
        if (index >= nums.length) {
            return 0;
        }

        // Pick current element
        int pick = nums[index] + maxSum(nums, index + 2);

        // Skip current element
        int notPick = maxSum(nums, index + 1);

        return Math.max(pick, notPick);
    }

    public static void main(String[] args) {

        int[] nums = {2, 1, 4, 9};

        System.out.println(maxSum(nums, 0));
    }
}

time =O(2^n)
space=O(n)

import java.util.Arrays;

public class Main {

    static int solve(int[] nums, int index, int[] dp) {

        if (index >= nums.length)
            return 0;

        if (dp[index] != -1)
            return dp[index];

        int pick = nums[index] + solve(nums, index + 2, dp);
        int notPick = solve(nums, index + 1, dp);

        return dp[index] = Math.max(pick, notPick);
    }

    public static void main(String[] args) {

        int[] nums = {2, 1, 4, 9};

        int[] dp = new int[nums.length];
        Arrays.fill(dp, -1);

        System.out.println(solve(nums, 0, dp));
    }
}

time=O(n)
space=O(n)
