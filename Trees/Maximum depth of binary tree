class Solution {
    public int maxDepth(TreeNode root) {
        return solve(root);
    }
    public int solve(TreeNode root){
        if(root==null){
            return 0;
        }
        int l=solve(root.left)+1;
        int r=solve(root.right)+1;
        return Math.max(l,r);
    }
}

time=O(n);
space=O(h);
