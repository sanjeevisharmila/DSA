class Solution {
    public List<Integer> inorderTraversal(TreeNode root) {
        List<Integer>ans=new ArrayList<>();
        solve(root,ans);
        return ans;
    }
    public void solve(TreeNode root,List<Integer>ans){
        if(root==null){
            return;
        }
        solve(root.left,ans);
        ans.add(root.val);
        solve(root.right,ans);
    }
}

time=O(n)
space=O(h)

class Solution {
    public List<Integer> inorderTraversal(TreeNode root) {
        List<Integer>ans=new ArrayList<>();
        Stack<TreeNode>st=new Stack<>();
        TreeNode cur=root;
        while(cur!=null || !st.isEmpty()){
            while(cur!=null){
                st.push(cur);
                cur=cur.left;
            }
            cur=st.pop();
            ans.add(cur.val);
            cur=cur.right;
        }
        return ans;
    }
}

time=O(n)
space=O(h)
