class Solution {
    public List<List<Integer>> levelOrder(TreeNode root) {
        List<List<Integer>> ans= new ArrayList<>();
        Queue<TreeNode> qu= new LinkedList<>();
        if(root== null){
            return ans;
        }
        qu.add(root);
        while(!qu.isEmpty()){
            List<Integer> arr=new ArrayList<>();
            int len=qu.size();
            for(int i=0;i<len;i++){
                TreeNode cur=qu.poll();
                arr.add(cur.val);
                if(cur.left!=null){
                    qu.add(cur.left);
                }
                if(cur.right!=null){
                    qu.add(cur.right);
                }
            }
            ans.add(arr);
        }
        return ans;
    }
}


time=O(n)
space=O(n);
