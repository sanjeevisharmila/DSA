class Solution {
    class Pair {
         TreeNode node;
         int index;
         Pair(TreeNode node, int index) {
         this.node = node;
         this.index = index;
    }
}
    public int widthOfBinaryTree(TreeNode root) {
        int res=Integer.MIN_VALUE;
        Queue<Pair>temp=new LinkedList<>();
        if(root!=null){
            temp.offer(new Pair(root,0));
        }
        while(!temp.isEmpty()){
            int len=temp.size();
            int minindex=temp.peek().index;
            int ans=Integer.MIN_VALUE;
            for(int i=0;i<len;i++){
                Pair cur=temp.poll();
                ans=Math.max(ans,cur.index-minindex+1);
                if(cur.node.left!=null){
                    temp.offer(new Pair(cur.node.left,2*cur.index+1));
                }
                if(cur.node.right!=null){
                    temp.offer(new Pair(cur.node.right,2*cur.index+2));
                }
            }
            res=Math.max(res,ans);
        }
        return res;
    }
}

time=O(n)
space=O(n)
