class Solution {
    public static int kthLargest(int arr[], int k) {
        Queue<Integer>ans=new PriorityQueue<>();
        for(int it:arr){
            ans.add(it);
        }
        int ind=arr.length-k;
        while(ind>0){
            ans.poll();
            ind--;
        }
        return ans.peek();
    }
}
